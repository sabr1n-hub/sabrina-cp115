<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-test-1"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-21 10:31:49 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0yMTswOTo0NDozMCBBTTsyNzQw"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0yMTsxMDozMTo0OSBBTTs0OzI4NDk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="weight" type="Integer" array="False" size=""/>
            <input variable="weight"/>
            <declare name="totalCharge" type="Real" array="False" size=""/>
            <if expression="weight&lt;=5">
                <then>
                    <assign variable="totalCharge" expression="weight*8"/>
                </then>
                <else>
                    <assign variable="totalCharge" expression="5*8+(weight-5)*6"/>
                </else>
            </if>
            <if expression="totalCharge&gt;60">
                <then>
                    <declare name="handlingFee" type="Integer" array="False" size=""/>
                    <assign variable="handlingFee" expression="totalCharge+10"/>
                </then>
                <else/>
            </if>
            <output expression="weight" newline="True"/>
            <output expression="totalCharge" newline="True"/>
        </body>
    </function>
</flowgorithm>
